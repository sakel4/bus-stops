# Bearer token for rest.citybus.gr (server-only, never sent to the browser). Required for local
# development, the only place it is read from there. In production it is a fallback: the token lives
# in Global Config and is refreshed from the citybus site on a 401 (src/lib/citybus-token.ts).
CITYBUS_TOKEN=
# Vercel Global Config connection string; set automatically when the store is connected to the project.
# The current citybus token is kept there under the key "citybusToken".
GLOBAL_CONFIG=
# Vercel access token allowed to write that Global Config (saves refreshed tokens), and the team id
# if the store belongs to a team.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
# Public origin used for absolute URLs (link previews). On Vercel the production domain is used automatically.
SITE_URL=
