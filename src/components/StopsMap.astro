---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getStopName, getStopUrl, type Stop } from '../lib/stops';

interface Props {
  lang: Lang;
  stops: Stop[];
}

const { lang, stops } = Astro.props;
const t = useTranslations(lang);

// Only ship what the map needs to the browser.
const mapData = {
  labels: {
    code: t('stop.code'),
    lines: t('stop.lines'),
    details: t('map.details'),
    you: t('locate.you'),
    locate: t('locate.label'),
  },
  stops: stops.map((s) => ({
    code: s.code,
    name: getStopName(s, lang),
    lat: s.latitude,
    lng: s.longitude,
    lines: s.lineCodes,
    url: getStopUrl(s, lang),
  })),
};
---

<div class="relative h-full w-full">
  <div data-stops-map class="absolute inset-0 z-0" role="region" aria-label={t('map.label')}></div>
  <script type="application/json" data-stops-map-data set:html={JSON.stringify(mapData)} />
</div>

<script>
  import L from 'leaflet';
  import { canLocate, LOCATE_ICON_PATH } from '../lib/geo';
  import { canHover, createMap, STOP_STYLE, stopPopupHtml } from '../lib/map';

  const HIGHLIGHT_STYLE = { color: '#c2410c', fillColor: '#f97316', fillOpacity: 1 };

  /** Small dots for the whole city, bigger ones (easier to tap) on the street level. */
  const radiusFor = (zoom: number) => Math.min(8, Math.max(3, zoom - 9));

  const LOCATE_ICON = `<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="${LOCATE_ICON_PATH}" clip-rule="evenodd"/></svg>`;

  interface MapStop {
    code: string;
    name: string;
    lat: number;
    lng: number;
    lines: string[];
    url: string;
  }

  const container = document.querySelector<HTMLElement>('[data-stops-map]');
  const dataEl = document.querySelector<HTMLScriptElement>('[data-stops-map-data]');

  if (container && dataEl) {
    const { labels, stops } = JSON.parse(dataEl.textContent ?? '{}') as {
      labels: { code: string; lines: string; details: string; you: string; locate: string };
      stops: MapStop[];
    };

    const map = createMap(container);

    const markers = new Map<string, L.CircleMarker>();
    const hover = canHover();
    const layer = L.featureGroup().addTo(map);

    for (const stop of stops) {
      const marker = L.circleMarker([stop.lat, stop.lng], { ...STOP_STYLE, radius: 6, weight: 2 });
      // Names on hover save opening popups one by one (mouse only; a tap opens the popup).
      if (hover) marker.bindTooltip(stop.name, { direction: 'top', offset: [0, -6] });
      marker.bindPopup(
        stopPopupHtml({
          name: stop.name,
          details: [`${labels.code}: ${stop.code}`, `${labels.lines}: ${stop.lines.join(', ')}`],
          url: stop.url,
          linkLabel: labels.details,
        }),
      );
      markers.set(stop.code, marker);
      marker.addTo(layer);
    }

    const allBounds = layer.getBounds();
    map.fitBounds(allBounds, { padding: [20, 20] });

    // Stop highlighted from the list (hover or keyboard focus), drawn bigger and in orange.
    let highlighted: string | null = null;

    const applySizes = () => {
      const radius = radiusFor(map.getZoom());
      const weight = radius <= 4 ? 1.5 : 2;
      for (const [code, marker] of markers) {
        marker.setRadius(code === highlighted ? radius + 3 : radius);
        marker.setStyle({ weight });
      }
    };
    map.on('zoomend', applySizes);
    applySizes();

    window.addEventListener('stops:highlight', (event) => {
      const code = (event as CustomEvent<{ code: string | null }>).detail.code;
      if (code === highlighted) return;
      if (highlighted) markers.get(highlighted)?.setStyle(STOP_STYLE);
      highlighted = code;
      const marker = code ? markers.get(code) : undefined;
      if (marker) marker.setStyle(HIGHLIGHT_STYLE).bringToFront();
      applySizes();
    });

    // "Near me" on the map itself: on phones the map comes first and the list's button is
    // further down. The stop list does the work (it listens for 'stops:locate').
    if (canLocate()) {
      const LocateControl = L.Control.extend({
        onAdd() {
          const bar = L.DomUtil.create('div', 'leaflet-bar md:hidden');
          const button = L.DomUtil.create('button', 'map-locate', bar);
          button.type = 'button';
          button.title = button.ariaLabel = labels.locate;
          button.innerHTML = LOCATE_ICON;
          L.DomEvent.disableClickPropagation(bar);
          L.DomEvent.on(button, 'click', () => window.dispatchEvent(new CustomEvent('stops:locate')));
          return bar;
        },
      });
      new LocateControl({ position: 'topright' }).addTo(map);
    }

    // Keep the map in sync with the search box in the stop list.
    window.addEventListener('stops:filter', (event) => {
      const codes = (event as CustomEvent<{ codes: string[] | null }>).detail.codes;
      const visible = codes ? new Set(codes) : null;
      // The map may have just changed size (it shrinks on phones during "near me").
      map.invalidateSize();

      for (const [code, marker] of markers) {
        const show = !visible || visible.has(code);
        if (show && !layer.hasLayer(marker)) layer.addLayer(marker);
        if (!show && layer.hasLayer(marker)) layer.removeLayer(marker);
      }

      if (visible && visible.size > 0) {
        map.fitBounds(layer.getBounds(), { padding: [40, 40], maxZoom: 16 });
      } else if (!visible) {
        map.fitBounds(allBounds, { padding: [20, 20] });
      }
    });

    // Show the user's position from the "near me" button in the stop list. The stop
    // list has already filtered the map to the nearest stops via 'stops:filter'.
    const userLayer = L.layerGroup().addTo(map);
    window.addEventListener('stops:located', (event) => {
      const { position, nearest } = (
        event as CustomEvent<{
          position: { lat: number; lng: number; accuracy: number } | null;
          nearest?: string;
        }>
      ).detail;

      map.invalidateSize();
      userLayer.clearLayers();
      if (!position) {
        map.closePopup();
        return;
      }

      const here = L.latLng(position.lat, position.lng);
      L.circle(here, {
        radius: position.accuracy,
        color: '#ea580c',
        weight: 1,
        fillOpacity: 0.1,
        interactive: false,
      }).addTo(userLayer);
      L.circleMarker(here, {
        radius: 8,
        color: '#ffffff',
        weight: 3,
        fillColor: '#ea580c',
        fillOpacity: 1,
      })
        .bindTooltip(labels.you)
        .addTo(userLayer);

      map.fitBounds(layer.getBounds().extend(here), { padding: [40, 40], maxZoom: 17 });
      if (nearest) markers.get(nearest)?.openPopup();
    });
  }
</script>
