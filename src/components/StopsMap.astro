---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getStopName, getStopUrl, type Stop } from '../lib/stops';

interface Props {
  lang: Lang;
  stops: Stop[];
}

const { lang, stops } = Astro.props;
const t = useTranslations(lang);

// Only ship what the map needs to the browser.
const mapData = {
  labels: {
    code: t('stop.code'),
    lines: t('stop.lines'),
    details: t('map.details'),
    you: t('locate.you'),
  },
  stops: stops.map((s) => ({
    code: s.code,
    name: getStopName(s, lang),
    lat: s.latitude,
    lng: s.longitude,
    lines: s.lineCodes,
    url: getStopUrl(s, lang),
  })),
};
---

<div class="relative h-full w-full">
  <div data-stops-map class="absolute inset-0 z-0" role="region" aria-label={t('map.label')}></div>
  <script type="application/json" data-stops-map-data set:html={JSON.stringify(mapData)} />
</div>

<script>
  import L from 'leaflet';
  import { createMap, stopPopupHtml } from '../lib/map';

  interface MapStop {
    code: string;
    name: string;
    lat: number;
    lng: number;
    lines: string[];
    url: string;
  }

  const container = document.querySelector<HTMLElement>('[data-stops-map]');
  const dataEl = document.querySelector<HTMLScriptElement>('[data-stops-map-data]');

  if (container && dataEl) {
    const { labels, stops } = JSON.parse(dataEl.textContent ?? '{}') as {
      labels: { code: string; lines: string; details: string; you: string };
      stops: MapStop[];
    };

    const map = createMap(container);

    const markers = new Map<string, L.CircleMarker>();
    const layer = L.featureGroup().addTo(map);

    for (const stop of stops) {
      const marker = L.circleMarker([stop.lat, stop.lng], {
        radius: 6,
        color: '#1d4ed8',
        weight: 2,
        fillColor: '#3b82f6',
        fillOpacity: 0.85,
      }).bindPopup(
        stopPopupHtml({
          name: stop.name,
          details: [`${labels.code}: ${stop.code}`, `${labels.lines}: ${stop.lines.join(', ')}`],
          url: stop.url,
          linkLabel: labels.details,
        }),
      );
      markers.set(stop.code, marker);
      marker.addTo(layer);
    }

    const allBounds = layer.getBounds();
    map.fitBounds(allBounds, { padding: [20, 20] });

    // Keep the map in sync with the search box in the stop list.
    window.addEventListener('stops:filter', (event) => {
      const codes = (event as CustomEvent<{ codes: string[] | null }>).detail.codes;
      const visible = codes ? new Set(codes) : null;

      for (const [code, marker] of markers) {
        const show = !visible || visible.has(code);
        if (show && !layer.hasLayer(marker)) layer.addLayer(marker);
        if (!show && layer.hasLayer(marker)) layer.removeLayer(marker);
      }

      if (visible && visible.size > 0) {
        map.fitBounds(layer.getBounds(), { padding: [40, 40], maxZoom: 16 });
      } else if (!visible) {
        map.fitBounds(allBounds, { padding: [20, 20] });
      }
    });

    // Show the user's position from the "near me" button in the stop list. The stop
    // list has already filtered the map to the nearest stops via 'stops:filter'.
    const userLayer = L.layerGroup().addTo(map);
    window.addEventListener('stops:located', (event) => {
      const { position, nearest } = (
        event as CustomEvent<{
          position: { lat: number; lng: number; accuracy: number } | null;
          nearest?: string;
        }>
      ).detail;

      userLayer.clearLayers();
      if (!position) {
        map.closePopup();
        return;
      }

      const here = L.latLng(position.lat, position.lng);
      L.circle(here, {
        radius: position.accuracy,
        color: '#ea580c',
        weight: 1,
        fillOpacity: 0.1,
        interactive: false,
      }).addTo(userLayer);
      L.circleMarker(here, {
        radius: 8,
        color: '#ffffff',
        weight: 3,
        fillColor: '#ea580c',
        fillOpacity: 1,
      })
        .bindTooltip(labels.you)
        .addTo(userLayer);

      map.fitBounds(layer.getBounds().extend(here), { padding: [40, 40], maxZoom: 17 });
      if (nearest) markers.get(nearest)?.openPopup();
    });
  }
</script>
