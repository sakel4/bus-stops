---
import Layout from '../layouts/Layout.astro';
import BackLink from './BackLink.astro';
import RetryMessage from './RetryMessage.astro';
import { getLang, localizePath, useTranslations } from '../i18n/utils';
import { getLineCodes, getLineUrl } from '../lib/line-routes';
import { getLineColor } from '../lib/lines';
import { DAYS, SCHEDULE_LINES } from '../lib/schedules';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const routeLines = new Set(getLineCodes());

const dayLabels = Object.fromEntries(DAYS.map((day) => [day, t(`schedules.day.${day}`)]));
const labels = {
  noToday: t('schedules.noToday'),
  pdfTitle: t('schedules.pdfTitle', { line: '{line}', day: '{day}' }),
};
---

<Layout
  fullTitle={t('schedules.metaTitle')}
  description={t('schedules.metaDescription')}
  path="schedules"
>
  <div class="h-full overflow-y-auto">
    <article
      class="page-content"
      data-schedules-page
      data-url="/api/schedules"
      data-days={JSON.stringify(dayLabels)}
      data-labels={JSON.stringify(labels)}
      aria-busy="true"
    >
      <BackLink href={localizePath(lang)}>{t('stop.back')}</BackLink>

      <header>
        <h1 class="text-2xl font-semibold">{t('schedules.title')}</h1>
        <p class="mt-1 text-sm text-slate-500">
          {t('schedules.intro')}{' '}
          <a
            href="https://astiko-irakleiou.gr/dromologia/"
            class="underline hover:text-slate-900"
            target="_blank"
            rel="noopener">astiko-irakleiou.gr</a
          >
        </p>
      </header>

      <RetryMessage class="card p-4" message={t('schedules.error')} />

      <!-- The operator's combined timetable of every line. -->
      <section class="card flex flex-wrap items-center justify-between gap-3 p-4" data-all hidden>
        <h2 class="font-semibold">{t('schedules.all')}</h2>
        <div class="flex flex-wrap gap-2" data-all-links>
          {
            DAYS.map((day) => (
              <a class="btn-secondary" data-day={day} target="_blank" rel="noopener" hidden>
                {dayLabels[day]} ↗
              </a>
            ))
          }
        </div>
      </section>

      <ul class="flex flex-col gap-3" data-skeleton aria-hidden="true">
        {
          [0, 1, 2, 3, 4, 5].map(() => (
            <li class="card flex animate-pulse items-center gap-3 p-4">
              <span class="h-7 w-10 rounded-md bg-slate-200" />
              <span class="h-4 flex-1 rounded bg-slate-200" />
            </li>
          ))
        }
      </ul>

      <!-- Lines with at least one timetable. Cards are shown by the script once we know. -->
      <div class="flex flex-col gap-3" data-lines>
        {
          SCHEDULE_LINES.map((line) => (
            <details class="card group overflow-hidden" data-line={line.code} hidden>
              <summary class="flex cursor-pointer list-none items-center gap-3 p-4 hover:bg-slate-50 [&::-webkit-details-marker]:hidden">
                <span
                  class="line-chip w-12 shrink-0 py-1 text-center"
                  style={{ backgroundColor: getLineColor(line.code) }}
                  aria-hidden="true"
                >
                  {line.code}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block font-medium break-words">{line.name[lang]}</span>
                  <span class="block text-xs text-slate-500" data-summary-days />
                </span>
                <svg
                  class="size-5 shrink-0 text-slate-400 transition-transform group-open:rotate-180"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </summary>

              <div class="flex flex-col gap-3 border-t border-slate-200 p-4">
                <div class="flex flex-wrap items-center gap-2" role="group" aria-label={t('schedules.dayPicker')}>
                  {
                    DAYS.map((day) => (
                      <button
                        type="button"
                        class="rounded-full border border-slate-300 px-3 py-1 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100 aria-pressed:border-blue-700 aria-pressed:bg-blue-700 aria-pressed:text-white"
                        data-day={day}
                        aria-pressed="false"
                        hidden
                      >
                        {dayLabels[day]}
                      </button>
                    ))
                  }
                </div>
                <p class="text-sm text-amber-700" data-no-today hidden />

                <div class="flex flex-wrap gap-2">
                  <a class="btn-secondary" data-open target="_blank" rel="noopener">
                    {t('schedules.open')} ↗
                  </a>
                  {routeLines.has(line.code) && (
                    <a class="btn-secondary" href={getLineUrl(line.code, lang)}>
                      {t('schedules.route')}
                    </a>
                  )}
                </div>

                <!-- Filled with an <iframe> on first open, on devices that can show PDFs inline. -->
                <div data-frame hidden />
              </div>
            </details>
          ))
        }
      </div>

      <!-- Lines with no timetable right now. -->
      <section class="card p-4" data-inactive hidden>
        <h2 class="font-semibold">{t('schedules.inactive')}</h2>
        <p class="mt-1 text-sm text-slate-500">{t('schedules.inactiveNote')}</p>
        <ul class="mt-3 flex flex-col gap-2">
          {
            SCHEDULE_LINES.map((line) => (
              <li class="flex items-center gap-3 text-sm text-slate-500" data-inactive-line={line.code} hidden>
                <span
                  class="line-chip w-12 shrink-0 py-0.5 text-center opacity-60"
                  style={{ backgroundColor: getLineColor(line.code) }}
                  aria-hidden="true"
                >
                  {line.code}
                </span>
                <span>{line.name[lang]}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </article>
  </div>
</Layout>

<script>
  import { fetchJson, partOf } from '../lib/dom';
  import { ALL_LINES, getPdfUrl, getToday, type Day, type SchedulesResponse } from '../lib/schedules';

  const root = document.querySelector<HTMLElement>('[data-schedules-page]');
  if (root) {
    const dayLabels = JSON.parse(root.dataset.days!) as Record<Day, string>;
    const labels = JSON.parse(root.dataset.labels!) as Record<'noToday' | 'pdfTitle', string>;
    const part = partOf(root);
    const today = getToday();

    // Android Chrome and most phones can't render a PDF inside an iframe: there we only show the link.
    const canEmbed = () => navigator.pdfViewerEnabled !== false && matchMedia('(min-width: 768px)').matches;

    const showDay = (card: HTMLDetailsElement, line: string, day: Day) => {
      const url = getPdfUrl(line, day);
      for (const button of card.querySelectorAll<HTMLButtonElement>('button[data-day]')) {
        button.setAttribute('aria-pressed', String(button.dataset.day === day));
      }
      card.querySelector<HTMLAnchorElement>('[data-open]')!.href = url;

      const frameBox = card.querySelector<HTMLElement>('[data-frame]')!;
      // Only load the PDF once the card is open, so the page doesn't fetch 20 PDFs at once.
      if (!card.open || !canEmbed()) {
        frameBox.hidden = true;
        return;
      }
      let frame = frameBox.querySelector('iframe');
      if (!frame) {
        frame = document.createElement('iframe');
        frame.className = 'h-[75vh] w-full rounded-md border border-slate-200 bg-slate-100';
        frameBox.append(frame);
      }
      frame.title = labels.pdfTitle.replace('{line}', line).replace('{day}', dayLabels[day]);
      if (frame.src !== url) frame.src = url;
      frameBox.hidden = false;
    };

    const setupCard = (card: HTMLDetailsElement, days: Day[]) => {
      const line = card.dataset.line!;
      card.querySelector('[data-summary-days]')!.textContent = days.map((d) => dayLabels[d]).join(' · ');

      for (const button of card.querySelectorAll<HTMLButtonElement>('button[data-day]')) {
        const day = button.dataset.day as Day;
        button.hidden = !days.includes(day);
        button.onclick = () => {
          selected = day;
          showDay(card, line, day);
        };
      }

      // Open on today's timetable; say so when the line doesn't run today.
      let selected: Day = days.includes(today) ? today : days[0];
      const noToday = card.querySelector<HTMLElement>('[data-no-today]')!;
      noToday.textContent = labels.noToday;
      noToday.hidden = days.includes(today);

      card.ontoggle = () => showDay(card, line, selected);
      showDay(card, line, selected);
      card.hidden = false;
    };

    const render = (data: SchedulesResponse) => {
      const allDays = data.lines[ALL_LINES] ?? [];
      for (const link of part('all-links').querySelectorAll<HTMLAnchorElement>('a[data-day]')) {
        const day = link.dataset.day as Day;
        link.href = getPdfUrl(ALL_LINES, day);
        link.hidden = !allDays.includes(day);
      }
      part('all').hidden = allDays.length === 0;

      let inactiveCount = 0;
      for (const card of part('lines').querySelectorAll<HTMLDetailsElement>('details[data-line]')) {
        const line = card.dataset.line!;
        const days = data.lines[line] ?? [];
        const inactive = root.querySelector<HTMLElement>(`[data-inactive-line="${line}"]`)!;
        inactive.hidden = days.length > 0;
        card.hidden = days.length === 0;
        if (days.length > 0) setupCard(card, days);
        else inactiveCount++;
      }
      part('inactive').hidden = inactiveCount === 0;
    };

    const load = async () => {
      part('error').hidden = true;
      part('skeleton').hidden = false;
      root.setAttribute('aria-busy', 'true');
      try {
        render(await fetchJson<SchedulesResponse>(root.dataset.url!));
      } catch {
        part('error').hidden = false;
      } finally {
        part('skeleton').hidden = true;
        root.removeAttribute('aria-busy');
      }
    };

    // Switching between phone and desktop width shows or hides the inline PDFs.
    matchMedia('(min-width: 768px)').addEventListener('change', () => {
      for (const card of part('lines').querySelectorAll<HTMLDetailsElement>('details[data-line][open]')) {
        card.dispatchEvent(new Event('toggle'));
      }
    });

    part('retry').addEventListener('click', load);
    load();
  }
</script>
