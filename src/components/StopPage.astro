---
import Layout from '../layouts/Layout.astro';
import BackLink from './BackLink.astro';
import StopArrivals from './StopArrivals.astro';
import StopMap from './StopMap.astro';
import { getLang, localizePath, useTranslations } from '../i18n/utils';
import { getLineUrl } from '../lib/line-routes';
import { getLineColor } from '../lib/lines';
import { STAR_ICON_PATH } from '../lib/favorites';
import { getStopName, getStopPath, type Stop } from '../lib/stops';

interface Props {
  stop: Stop;
}

const { stop } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const name = getStopName(stop, lang);

// Search result snippets are short (~155 characters): list at most 5 lines.
const MAX_META_LINES = 5;
const shownLines = stop.lineCodes.slice(0, MAX_META_LINES).join(', ');
const hiddenLines = stop.lineCodes.length - MAX_META_LINES;
const lines =
  hiddenLines > 0 ? t('stop.metaMoreLines', { lines: shownLines, count: hiddenLines }) : shownLines;
// Google shows about 60 characters of a title; drop the city (it is in the description) when longer.
const MAX_TITLE_LENGTH = 60;
const fullTitle = t('stop.metaTitle', { name, code: stop.code });
const metaTitle =
  fullTitle.length <= MAX_TITLE_LENGTH ? fullTitle : t('stop.metaTitleShort', { name, code: stop.code });
const metaDescription = t('stop.metaDescription', { name, code: stop.code, lines });
---

<Layout map fullTitle={metaTitle} description={metaDescription} path={getStopPath(stop)}>
  <div class="h-full overflow-y-auto">
    <article class="page-content">
      <BackLink href={localizePath(lang)}>{t('stop.back')}</BackLink>

      <header class="flex flex-col gap-3">
        <div class="flex items-start justify-between gap-3">
          <h1 class="min-w-0 text-2xl font-semibold break-words">{name}</h1>
          <span
            class="shrink-0 rounded bg-slate-200 px-2 py-1 font-mono text-sm text-slate-700"
            title={t('stop.code')}
          >
            {stop.code}
          </span>
        </div>
        <!-- Its label follows the saved state (set by src/lib/favorites.ts). -->
        <button
          type="button"
          class="group fav-toggle btn-secondary inline-flex items-center gap-1.5 self-start aria-pressed:border-amber-300 aria-pressed:bg-amber-50 aria-pressed:text-amber-900 aria-pressed:hover:bg-amber-100"
          data-favorite={stop.code}
          aria-pressed="false"
        >
          <svg class="size-5" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true">
            <path d={STAR_ICON_PATH}></path>
          </svg>
          <span class="group-aria-pressed:hidden">{t('favorites.add')}</span>
          <span class="hidden group-aria-pressed:inline">{t('favorites.added')}</span>
        </button>
      </header>

      <section class="card p-4">
        <h2 class="mb-3 font-semibold">{t('stop.lines')}</h2>
        <ul class="flex flex-wrap gap-2">
          {
            stop.lineCodes.map((line) => (
              <li>
                <a
                  href={getLineUrl(line, lang, stop.code)}
                  class="line-chip block px-2.5 py-1"
                  style={{ backgroundColor: getLineColor(line) }}
                  title={t('stop.lineLink', { line })}
                  aria-label={t('stop.lineLink', { line })}
                >
                  {line}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <StopArrivals lang={lang} stop={stop} />

      <section class="card overflow-hidden">
        <div class="h-72">
          <StopMap lang={lang} stop={stop} />
        </div>
        <p class="border-t border-slate-200 px-4 py-2 text-xs text-slate-500">
          {t('stop.coordinates')}: {stop.latitude.toFixed(6)}, {stop.longitude.toFixed(6)}
        </p>
      </section>
    </article>
  </div>
</Layout>

<script>
  import { initFavoriteButtons } from '../lib/favorites';

  initFavoriteButtons();
</script>
