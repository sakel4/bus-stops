---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { buildSearchText } from '../lib/search';
import { getStopName, getStopUrl, type Stop } from '../lib/stops';

interface Props {
  lang: Lang;
  stops: Stop[];
}

const { lang, stops } = Astro.props;
const t = useTranslations(lang);
const countTemplate = t('list.count', { count: '{count}' });

// Texts the "near me" script shows; placeholders are kept as-is.
const locateLabels = {
  locating: t('locate.locating'),
  result: t('locate.result'),
  approximate: t('locate.approximate', { distance: '{distance}' }),
  privacy: t('locate.privacy'),
  far: t('locate.far', { distance: '{distance}' }),
  denied: t('locate.denied'),
  unavailable: t('locate.unavailable'),
};
---

<section
  class="flex h-full min-h-0 flex-col"
  data-stop-list
  data-count-template={countTemplate}
  data-lang={lang}
  data-locate-labels={JSON.stringify(locateLabels)}
>
  <div class="border-b border-slate-200 bg-white p-3">
    <label for="stop-search" class="sr-only">{t('search.label')}</label>
    <div class="flex gap-2">
      <div class="relative min-w-0 flex-1">
        <svg
          class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-slate-400"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M9 3.5a5.5 5.5 0 1 0 3.4 9.83l3.13 3.14a.75.75 0 1 0 1.06-1.06l-3.13-3.14A5.5 5.5 0 0 0 9 3.5ZM5 9a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z"
            clip-rule="evenodd"></path>
        </svg>
        <input
          id="stop-search"
          type="search"
          autocomplete="off"
          placeholder={t('search.placeholder')}
          class="w-full rounded-lg border border-slate-300 bg-white py-2 pr-3 pl-9 text-sm shadow-sm outline-none placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30"
          data-search-input
        />
      </div>
      <!-- Shown by the script only where the browser supports geolocation. -->
      <button
        type="button"
        class="btn-secondary inline-flex shrink-0 items-center gap-1.5"
        title={t('locate.label')}
        data-locate
        hidden
      >
        <svg class="size-4 text-blue-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="m9.69 18.933.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 0 0 .281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 1 0 3 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 0 0 2.273 1.765 11.842 11.842 0 0 0 .976.544l.062.029.018.008.006.003ZM10 11.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Z"
            clip-rule="evenodd"></path>
        </svg>
        {t('locate.button')}
      </button>
    </div>

    <div class="mt-3 rounded-lg bg-slate-50 p-3 text-sm" data-locate-status hidden>
      <p class="flex items-start gap-2 text-slate-700" role="status">
        <span
          class="mt-0.5 size-4 shrink-0 animate-spin rounded-full border-2 border-slate-300 border-t-blue-600"
          aria-hidden="true"
          data-locate-spinner
          hidden></span>
        <span data-locate-message></span>
      </p>
      <p class="mt-1 text-xs text-slate-500" data-locate-note hidden></p>
      <div class="mt-2 flex flex-wrap gap-2">
        <button type="button" class="btn-secondary" data-locate-action="cancel" hidden>
          {t('locate.cancel')}
        </button>
        <button type="button" class="btn-secondary" data-locate-action="retry" hidden>
          {t('locate.retry')}
        </button>
        <button type="button" class="btn-secondary" data-locate-action="reset" hidden>
          {t('locate.showAll')}
        </button>
        <button type="button" class="btn-secondary" data-locate-action="close" hidden>
          {t('locate.close')}
        </button>
      </div>
    </div>

    <p class="mt-2 text-xs text-slate-500" aria-live="polite" data-count>
      {t('list.count', { count: stops.length })}
    </p>
  </div>

  <ul class="min-h-0 flex-1 divide-y divide-slate-100 overflow-y-auto bg-white" data-items>
    {
      stops.map((stop) => {
        const name = getStopName(stop, lang);
        return (
          <li
            data-search={buildSearchText(...Object.values(stop.names), stop.code)}
            data-code={stop.code}
            data-lat={stop.latitude}
            data-lng={stop.longitude}
          >
            <a
              href={getStopUrl(stop, lang)}
              class="flex w-full items-center justify-between gap-3 px-4 py-3 text-left transition-colors hover:bg-blue-50 focus-visible:bg-blue-50 focus-visible:outline-none"
            >
              <span class="min-w-0">
                <span class="block truncate font-medium">{name}</span>
                <span class="block truncate text-xs text-slate-500">
                  {t('stop.lines')}: {stop.lineCodes.join(', ')}
                </span>
              </span>
              <span class="flex shrink-0 flex-col items-end gap-1">
                <span
                  class="rounded bg-slate-100 px-2 py-0.5 font-mono text-xs text-slate-700"
                  title={t('stop.code')}
                >
                  {stop.code}
                </span>
                <span class="text-xs font-semibold text-blue-700" data-distance hidden />
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
  <p class="flex-1 bg-white p-6 text-center text-sm text-slate-500" data-empty hidden>
    {t('list.empty')}
  </p>
</section>

<script>
  import { distanceMeters, formatDistance } from '../lib/geo';
  import { normalize, transliterate } from '../lib/search';

  const NEAREST_COUNT = 5;
  /** Beyond this, the user is probably not in Heraklion. */
  const FAR_METERS = 3_000;
  /** Warn when the browser reports a location less precise than this. */
  const APPROXIMATE_METERS = 500;

  type LocateAction = 'cancel' | 'retry' | 'reset' | 'close';

  const root = document.querySelector<HTMLElement>('[data-stop-list]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('[data-search-input]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const list = root.querySelector<HTMLElement>('[data-items]')!;
    const items = Array.from(root.querySelectorAll<HTMLLIElement>('li[data-search]'));
    const countTemplate = root.dataset.countTemplate ?? '{count}';

    const setCount = (n: number) => {
      count.textContent = countTemplate.replace('{count}', String(n));
      empty.hidden = n > 0;
      list.hidden = n === 0;
    };

    const applyFilter = () => {
      const q = normalize(input.value);
      const terms = q ? [q, transliterate(q)] : [];
      const visibleCodes: string[] = [];

      for (const item of items) {
        const text = item.dataset.search ?? '';
        const match = terms.length === 0 || terms.some((term) => text.includes(term));
        item.hidden = !match;
        if (match) visibleCodes.push(item.dataset.code!);
      }

      setCount(visibleCodes.length);

      // Let the map (or anything else) know which stops are visible.
      window.dispatchEvent(
        new CustomEvent('stops:filter', { detail: { codes: q ? visibleCodes : null } }),
      );
    };

    // --- Near me -----------------------------------------------------------------
    // The location is requested only when the user clicks the button, used here to
    // rank stops, and never sent anywhere or stored.

    const lang = root.dataset.lang;
    const labels = JSON.parse(root.dataset.locateLabels ?? '{}') as Record<
      'locating' | 'result' | 'approximate' | 'privacy' | 'far' | 'denied' | 'unavailable',
      string
    >;
    const locateButton = root.querySelector<HTMLButtonElement>('[data-locate]')!;
    const status = root.querySelector<HTMLElement>('[data-locate-status]')!;
    const statusMessage = root.querySelector<HTMLElement>('[data-locate-message]')!;
    const statusNote = root.querySelector<HTMLElement>('[data-locate-note]')!;
    const spinner = root.querySelector<HTMLElement>('[data-locate-spinner]')!;
    const actionButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-locate-action]'),
    );

    // Each request gets an id; answers to cancelled or outdated requests are ignored.
    let request = 0;
    let nearestMode = false;

    const showStatus = (
      message: string | null,
      { note = '', loading = false, actions = [] as LocateAction[] } = {},
    ) => {
      status.hidden = message === null;
      statusMessage.textContent = message ?? '';
      statusNote.textContent = note;
      statusNote.hidden = !note;
      spinner.hidden = !loading;
      for (const button of actionButtons) {
        button.hidden = !actions.includes(button.dataset.locateAction as LocateAction);
      }
    };

    /** Leave "nearest" mode: original order, no distances, no user marker on the map. */
    const clearNearest = () => {
      if (!nearestMode) return;
      nearestMode = false;
      for (const item of items) item.querySelector<HTMLElement>('[data-distance]')!.hidden = true;
      list.append(...items);
      window.dispatchEvent(new CustomEvent('stops:located', { detail: { position: null } }));
    };

    const showNearest = ({ latitude, longitude, accuracy }: GeolocationCoordinates) => {
      const here = { lat: latitude, lng: longitude };
      const nearest = items
        .map((item) => ({
          item,
          distance: distanceMeters(here, {
            lat: Number(item.dataset.lat),
            lng: Number(item.dataset.lng),
          }),
        }))
        .sort((a, b) => a.distance - b.distance)
        .slice(0, NEAREST_COUNT);

      if (nearest[0].distance > FAR_METERS) {
        const distance = formatDistance(nearest[0].distance, lang!);
        showStatus(labels.far.replace('{distance}', distance), { actions: ['close'] });
        return;
      }

      input.value = '';
      nearestMode = true;
      for (const item of items) item.hidden = true;
      for (const { item, distance } of nearest) {
        const label = item.querySelector<HTMLElement>('[data-distance]')!;
        label.textContent = formatDistance(distance, lang!);
        label.hidden = false;
        item.hidden = false;
      }
      list.prepend(...nearest.map(({ item }) => item));
      list.scrollTop = 0;
      setCount(nearest.length);

      const codes = nearest.map(({ item }) => item.dataset.code!);
      window.dispatchEvent(new CustomEvent('stops:filter', { detail: { codes } }));
      window.dispatchEvent(
        new CustomEvent('stops:located', {
          detail: { position: { ...here, accuracy }, nearest: codes[0] },
        }),
      );

      const approximate =
        accuracy > APPROXIMATE_METERS
          ? labels.approximate.replace('{distance}', formatDistance(accuracy, lang!)) + ' '
          : '';
      showStatus(labels.result, { note: approximate + labels.privacy, actions: ['reset'] });
    };

    const locate = () => {
      const id = ++request;
      if (nearestMode) {
        clearNearest();
        applyFilter();
      }
      showStatus(labels.locating, { loading: true, actions: ['cancel'] });

      navigator.geolocation.getCurrentPosition(
        (position) => {
          if (id === request) showNearest(position.coords);
        },
        (error) => {
          if (id !== request) return;
          if (error.code === error.PERMISSION_DENIED) {
            showStatus(labels.denied, { actions: ['close'] });
          } else {
            showStatus(labels.unavailable, { actions: ['retry', 'close'] });
          }
        },
        { enableHighAccuracy: true, timeout: 10_000, maximumAge: 60_000 },
      );
    };

    const actions: Record<LocateAction, () => void> = {
      // The browser can't abort a request; ignore its answer instead.
      cancel: () => {
        request++;
        showStatus(null);
      },
      retry: locate,
      reset: () => {
        clearNearest();
        showStatus(null);
        applyFilter();
      },
      close: () => showStatus(null),
    };
    for (const button of actionButtons) {
      button.addEventListener('click', () => actions[button.dataset.locateAction as LocateAction]());
    }

    // Geolocation only works on HTTPS (and localhost); hide the button elsewhere.
    if ('geolocation' in navigator && window.isSecureContext) {
      locateButton.hidden = false;
      locateButton.addEventListener('click', locate);
    }

    input.addEventListener('input', () => {
      // Typing a search replaces the "near me" results.
      request++;
      showStatus(null);
      clearNearest();
      applyFilter();
    });
    // Browsers may restore the input value on back/forward navigation.
    if (input.value) applyFilter();
  }
</script>
