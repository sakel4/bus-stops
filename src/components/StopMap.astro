---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import type { Stop } from '../lib/stops';

interface Props {
  lang: Lang;
  stop: Stop;
}

const { lang, stop } = Astro.props;
const t = useTranslations(lang);

// Templates the browser fills in; placeholders are kept as-is.
const labels = {
  touchHint: t('map.touchHint'),
  bus: t('map.bus', { line: '{line}', time: '{time}' }),
};
---

<div
  data-stop-map
  data-lat={stop.latitude}
  data-lng={stop.longitude}
  data-labels={JSON.stringify(labels)}
  class="z-0 h-full w-full"
  role="region"
  aria-label={t('stop.map')}
>
</div>

<script>
  import L from 'leaflet';
  import type { StopArrivalsDetail } from '../lib/arrivals';
  import { getLineColor } from '../lib/lines';
  import { busMarker, createMap, STOP_STYLE } from '../lib/map';

  /** On the first update, zoom out to show the buses arriving within this many minutes. */
  const FIT_MINUTES = 10;

  const container = document.querySelector<HTMLElement>('[data-stop-map]');

  if (container) {
    const labels = JSON.parse(container.dataset.labels ?? '{}') as Record<
      'touchHint' | 'bus',
      string
    >;
    const position: L.LatLngTuple = [Number(container.dataset.lat), Number(container.dataset.lng)];

    const map = createMap(container, { embedded: { touchHint: labels.touchHint } }).setView(
      position,
      17,
    );

    L.circleMarker(position, { ...STOP_STYLE, radius: 8, weight: 2 }).addTo(map);

    // Live buses, from the arrivals that StopArrivals.astro loads and refreshes.
    const busLayer = L.layerGroup().addTo(map);
    let fitted = false;

    window.addEventListener('stop:arrivals', (event) => {
      const { arrivals } = (event as CustomEvent<StopArrivalsDetail>).detail;
      busLayer.clearLayers();

      for (const arrival of arrivals) {
        if (!arrival.position) continue;
        busMarker({
          line: arrival.line,
          color: getLineColor(arrival.line),
          position: arrival.position,
          label: labels.bus.replace('{line}', arrival.line).replace('{time}', arrival.time),
        }).addTo(busLayer);
      }

      // Only once: after that, leave the view to the user.
      const soon = arrivals.filter((a) => a.position && a.minutes <= FIT_MINUTES);
      if (!fitted && soon.length > 0) {
        fitted = true;
        const bounds = L.latLngBounds([position, ...soon.map((a) => a.position!)]);
        map.fitBounds(bounds, { padding: [30, 30], maxZoom: 17 });
      }
    });
  }
</script>
