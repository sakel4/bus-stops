---
import Layout from '../layouts/Layout.astro';
import { getLang, localizePath, useTranslations } from '../i18n/utils';
import { getLineDetailsUrl, getLinePath } from '../lib/line-routes';
import { getLineColor } from '../lib/lines';
import { getStopUrl } from '../lib/stops';

interface Props {
  line: string;
}

const { line } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const color = getLineColor(line);

// Templates the browser fills in; placeholders are kept as-is.
const labels = {
  stopCount: t('line.stopCount', { count: '{count}' }),
  thisStop: t('line.thisStop'),
  backToStop: t('line.backToStop'),
  code: t('stop.code'),
  details: t('map.details'),
};
const STOP_CODE = '__code__';
const stopUrl = getStopUrl({ code: STOP_CODE }, lang);

const buttonClass =
  'rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm transition-colors hover:border-slate-400 hover:bg-slate-100 focus-visible:ring-2 focus-visible:ring-blue-500/50 focus-visible:outline-none';
---

<Layout
  fullTitle={t('line.metaTitle', { line })}
  description={t('line.metaDescription', { line })}
  path={getLinePath(line)}
>
  <div class="h-full overflow-y-auto">
    <article
      class="mx-auto flex max-w-3xl flex-col gap-4 px-4 py-6"
      data-line-page
      data-url={getLineDetailsUrl(line, lang)}
      data-color={color}
      data-stop-url={stopUrl}
      data-stop-code={STOP_CODE}
      data-labels={JSON.stringify(labels)}
      aria-busy="true"
    >
      <a
        href={localizePath(lang)}
        class="inline-flex items-center gap-1.5 self-start rounded-lg border border-slate-300 bg-white py-1.5 pr-3 pl-2 text-sm font-medium text-slate-700 shadow-sm transition-colors hover:border-slate-400 hover:bg-slate-100 focus-visible:ring-2 focus-visible:ring-blue-500/50 focus-visible:outline-none"
        data-back
      >
        <svg class="size-4 text-slate-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z"
            clip-rule="evenodd"></path>
        </svg>
        <span data-back-label>{t('stop.back')}</span>
      </a>

      <header class="flex items-center gap-3">
        <span
          class="shrink-0 rounded-lg px-3 py-1.5 font-mono text-xl font-semibold text-white"
          style={{ backgroundColor: color }}
          aria-hidden="true"
        >
          {line}
        </span>
        <div class="min-w-0">
          <h1 class="text-2xl font-semibold">{t('line.title', { line })}</h1>
          <p class="text-sm break-words text-slate-500" data-line-name>
            <span class="inline-block h-4 w-40 animate-pulse rounded bg-slate-200 align-middle"></span>
          </p>
        </div>
      </header>

      <div class="hidden" role="status" data-error>
        <div
          class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm"
        >
          <p class="text-sm text-slate-500">{t('line.error')}</p>
          <button type="button" class={buttonClass} data-retry>{t('arrivals.retry')}</button>
        </div>
      </div>

      <div class="flex flex-col gap-4" data-content>
        <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
          <label for="line-route" class="mb-2 block font-semibold">{t('line.route')}</label>
          <select
            id="line-route"
            class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus-visible:border-blue-500 focus-visible:ring-2 focus-visible:ring-blue-500/50 focus-visible:outline-none disabled:animate-pulse disabled:bg-slate-100"
            disabled
            data-route></select>
        </section>

        <section class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
          <div class="h-80 bg-slate-100" data-line-map role="region" aria-label={t('line.map')}></div>
        </section>

        <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
          <div class="mb-2 flex items-baseline justify-between gap-3">
            <h2 class="font-semibold">{t('line.stops')}</h2>
            <p class="text-xs text-slate-500" data-stop-count></p>
          </div>

          <ul class="space-y-3 py-1" data-skeleton aria-hidden="true">
            {
              [0, 1, 2, 3, 4].map(() => (
                <li class="flex animate-pulse items-center gap-3">
                  <span class="size-3 rounded-full bg-slate-200" />
                  <span class="h-4 flex-1 rounded bg-slate-200" />
                </li>
              ))
            }
          </ul>

          <ol class="hidden" data-stops></ol>
        </section>
      </div>

      <template data-stop-row>
        <li class="group relative flex items-stretch gap-2">
          <span class="relative flex w-4 shrink-0 items-center justify-center" aria-hidden="true">
            <span
              class="absolute inset-y-0 left-1/2 w-1 -translate-x-1/2 group-first:top-1/2 group-last:bottom-1/2"
              data-rail></span>
            <span class="relative size-3 rounded-full border-[3px] bg-white" data-dot></span>
          </span>
          <a
            class="flex min-w-0 flex-1 items-center justify-between gap-3 rounded-md px-2 py-2 text-sm transition-colors hover:bg-slate-100 focus-visible:ring-2 focus-visible:ring-blue-500/50 focus-visible:outline-none"
            data-link
          >
            <span class="min-w-0">
              <span class="break-words" data-name></span>
              <span
                class="ml-1 hidden rounded bg-blue-600 px-1.5 py-0.5 text-xs font-semibold whitespace-nowrap text-white"
                data-this-stop></span>
            </span>
            <span class="shrink-0 font-mono text-xs text-slate-500" data-code></span>
          </a>
        </li>
      </template>
    </article>
  </div>
</Layout>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import type { LineDetailsResponse, LineRoute } from '../lib/line-routes';

  const root = document.querySelector<HTMLElement>('[data-line-page]');
  if (root) {
    const color = root.dataset.color!;
    const labels = JSON.parse(root.dataset.labels ?? '{}') as Record<
      'stopCount' | 'thisStop' | 'backToStop' | 'code' | 'details',
      string
    >;
    const stopUrl = (code: string) => root.dataset.stopUrl!.replace(root.dataset.stopCode!, code);
    const part = <T extends HTMLElement = HTMLElement>(name: string) =>
      root.querySelector<T>(`[data-${name}]`)!;
    const routeSelect = part<HTMLSelectElement>('route');
    const stopList = part('stops');
    const rowTemplate = part<HTMLTemplateElement>('stop-row');

    // Opened from a stop page: link back to it and highlight it along the route.
    const params = new URLSearchParams(location.search);
    const fromStop = params.get('stop')?.match(/^\d{1,6}$/)?.[0];
    if (fromStop) {
      part<HTMLAnchorElement>('back').href = stopUrl(fromStop);
      part('back-label').textContent = labels.backToStop;
      // Keep the stop when switching language.
      for (const link of document.querySelectorAll<HTMLAnchorElement>('a[hreflang]')) {
        link.search = `?stop=${fromStop}`;
      }
    }

    // The map is created on first use: its container must be visible to size itself.
    let map: L.Map | undefined;
    let routeLayer: L.FeatureGroup | undefined;

    const escape = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

    const drawMap = (route: LineRoute) => {
      if (!map) {
        map = L.map(part('line-map'), { preferCanvas: true });
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        }).addTo(map);
        routeLayer = L.featureGroup().addTo(map);
        const resizeMap = map;
        new ResizeObserver(() => resizeMap.invalidateSize()).observe(part('line-map'));
      }
      routeLayer!.clearLayers();

      L.polyline(route.path, { color, weight: 5, opacity: 0.8 }).addTo(routeLayer!);
      for (const stop of route.stops) {
        const current = stop.code === fromStop;
        L.circleMarker([stop.latitude, stop.longitude], {
          radius: current ? 9 : 5,
          color,
          weight: current ? 3 : 2,
          fillColor: current ? color : '#ffffff',
          fillOpacity: 1,
        })
          .bindPopup(
            `<strong>${escape(stop.name)}</strong><br>` +
              `${escape(labels.code)}: ${escape(stop.code)}<br>` +
              // `!` so Tailwind wins over Leaflet's `.leaflet-container a` color.
              `<a href="${escape(stopUrl(stop.code))}" class="mt-2 inline-flex items-center gap-1 rounded-md bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white! no-underline! transition-colors hover:bg-blue-700">` +
              `${escape(labels.details)} <span aria-hidden="true">›</span></a>`,
          )
          .addTo(routeLayer!);
      }
      map.fitBounds(routeLayer!.getBounds(), { padding: [20, 20] });
    };

    const renderStop = (stop: LineRoute['stops'][number]) => {
      const row = rowTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const current = stop.code === fromStop;
      row.querySelector<HTMLElement>('[data-rail]')!.style.backgroundColor = color;
      const dot = row.querySelector<HTMLElement>('[data-dot]')!;
      dot.style.borderColor = color;
      if (current) {
        dot.style.backgroundColor = color;
        dot.classList.replace('size-3', 'size-4');
      }
      const link = row.querySelector<HTMLAnchorElement>('[data-link]')!;
      link.href = stopUrl(stop.code);
      if (current) {
        link.setAttribute('aria-current', 'location');
        link.classList.add('bg-blue-50', 'font-semibold');
        const badge = row.querySelector<HTMLElement>('[data-this-stop]')!;
        badge.textContent = labels.thisStop;
        badge.classList.remove('hidden');
      }
      row.querySelector('[data-name]')!.textContent = stop.name;
      row.querySelector('[data-code]')!.textContent = stop.code;
      return row;
    };

    const showRoute = (route: LineRoute) => {
      stopList.replaceChildren(...route.stops.map(renderStop));
      part('stop-count').textContent = labels.stopCount.replace('{count}', String(route.stops.length));
      drawMap(route);
    };

    const render = (data: LineDetailsResponse) => {
      part('line-name').textContent = data.name;
      if (data.routes.length === 0) throw new Error('No routes');

      // Open on the route from the URL, else the first one through the stop we came from.
      const initial =
        data.routes.find((route) => route.code === params.get('route')) ??
        data.routes.find((route) => route.stops.some((stop) => stop.code === fromStop)) ??
        data.routes[0];

      routeSelect.replaceChildren(
        ...data.routes.map((route) => new Option(route.name, route.code, false, route === initial)),
      );
      routeSelect.disabled = false;
      routeSelect.onchange = () => {
        const route = data.routes.find((r) => r.code === routeSelect.value);
        if (!route) return;
        // Remember the route in the URL so a shared link opens the same route.
        params.set('route', route.code);
        history.replaceState(null, '', `?${params}`);
        showRoute(route);
      };

      part('skeleton').classList.add('hidden');
      stopList.classList.remove('hidden');
      showRoute(initial);
    };

    const load = async () => {
      part('error').classList.add('hidden');
      part('content').classList.remove('hidden');
      root.setAttribute('aria-busy', 'true');
      try {
        const res = await fetch(root.dataset.url!);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        render((await res.json()) as LineDetailsResponse);
      } catch {
        part('line-name').textContent = '';
        part('content').classList.add('hidden');
        part('error').classList.remove('hidden');
      } finally {
        root.removeAttribute('aria-busy');
      }
    };

    part('retry').addEventListener('click', load);
    load();
  }
</script>
