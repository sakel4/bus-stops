---
import '../styles/global.css';
import LanguagePicker from '../components/LanguagePicker.astro';
import { languages, type Lang } from '../i18n/ui';
import { getLang, localizePath, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  /** Path without locale prefix, used for the language switcher / hreflang. */
  path?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { title, description = t('site.description'), path = '' } = Astro.props;
const pageTitle = title ? `${title} · ${t('site.title')}` : t('site.title');
---

<!doctype html>
<html lang={lang} class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      (Object.keys(languages) as Lang[]).map((code) => (
        <link rel="alternate" hreflang={code} href={localizePath(code, path)} />
      ))
    }
    <title>{pageTitle}</title>
  </head>
  <body class="flex h-full flex-col bg-slate-50 text-slate-900 antialiased">
    <header class="bg-blue-700 text-white shadow">
      <div class="flex items-center justify-between gap-4 px-4 py-3">
        <a href={localizePath(lang)} class="flex items-center gap-2 text-lg font-semibold">
          <img src="/favicon.svg" alt="" class="size-7" />
          {t('site.title')}
        </a>
        <LanguagePicker lang={lang} path={path} />
      </div>
    </header>
    <main class="min-h-0 flex-1">
      <slot />
    </main>
  </body>
</html>
