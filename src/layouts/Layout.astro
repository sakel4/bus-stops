---
import '../styles/global.css';
import LanguagePicker from '../components/LanguagePicker.astro';
import SupportDialog from '../components/SupportDialog.astro';
import ServiceNotice from '../components/ServiceNotice.astro';
import BottomNav from '../components/BottomNav.astro';
import { defaultLang, languages, type Lang } from '../i18n/ui';
import { getLang, localizePath, useTranslations } from '../i18n/utils';
import Analytics from '@vercel/analytics/astro';

interface Props {
  /** Page name; shown as "{title} · {site title}". */
  title?: string;
  /** Complete <title>, used as-is instead of `title` (for pages with search-tuned titles). */
  fullTitle?: string;
  description?: string;
  /** Path without locale prefix, used for the language switcher / hreflang. */
  path?: string;
  /** The page shows a map: connect to the tile server early, as the first tiles are often the largest paint. */
  map?: boolean;
  /** Keep the page out of search results (e.g. the offline page). */
  noindex?: boolean;
  /** Structured data (schema.org) for search engines, rendered as JSON-LD. See src/lib/seo.ts. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const {
  title,
  fullTitle,
  description = t('site.description'),
  path = '',
  map = false,
  noindex = false,
  jsonLd,
} = Astro.props;
// The home page title also says what the site is, for search results and link previews.
const homeTitle = `${t('site.name')} – ${t('site.title')}`;
const pageTitle = fullTitle ?? (title ? `${title} · ${t('site.name')}` : homeTitle);

// Link previews (Facebook, Instagram DMs, X/Twitter, Discord, chat apps). These need absolute URLs.
const ogLocales: Record<Lang, string> = { el: 'el_GR', en: 'en_US' };
// Bump `v` whenever og-image.jpg changes: Facebook, Discord and X cache previews by URL.
const imageUrl = new URL('/og-image.jpg?v=3', Astro.site).href;
// hreflang links must be absolute; x-default points search engines to the Greek (default) version.
const alternateUrl = (code: Lang) => new URL(localizePath(code, path), Astro.site).href;
// Built from `path` like the hreflang links, so it always has the trailing slash and no query string:
// /stops/0122, /stops/0122/ and /lines/06/?stop=0122 all point search engines to one URL.
const pageUrl = alternateUrl(lang);
---

<!doctype html>
<html lang={lang} class="h-full">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: the installed app draws under the notch; the header and footer
         pad themselves with the safe-area insets. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <!-- Google Search shows a favicon only if it is square and a multiple of 48px (48, 96, 192…);
         favicon.ico holds 16, 32 and 48px. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1d4ed8" />
    <!-- Installable app (PWA): one manifest per language, so each opens in its own language. -->
    <link rel="manifest" href={lang === defaultLang ? '/manifest.webmanifest' : `/${lang}/manifest.webmanifest`} />
    <meta name="apple-mobile-web-app-title" content={t('site.name')} />
    <!-- iOS home-screen app: the blue header continues under the status bar. -->
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    {map && <link rel="preconnect" href="https://tile.openstreetmap.org" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={fullTitle ?? title ?? homeTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {
      (Object.keys(languages) as Lang[])
        .filter((code) => code !== lang)
        .map((code) => <meta property="og:locale:alternate" content={ogLocales[code]} />)
    }
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('og.imageAlt')} />
    <!-- X/Twitter reads og:title/description/image; it only needs the card type. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={t('og.imageAlt')} />
    {
      (Object.keys(languages) as Lang[]).map((code) => (
        <link rel="alternate" hreflang={code} href={alternateUrl(code)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={alternateUrl(defaultLang)} />
    {!noindex && <link rel="canonical" href={pageUrl} />}
    {
      jsonLd && (
        // Escaping "<" keeps a "</script>" inside the data from ending the tag.
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')} />
      )
    }
    <title>{pageTitle}</title>
  </head>
  <body
    class="flex h-full flex-col bg-slate-50 pr-[env(safe-area-inset-right)] pl-[env(safe-area-inset-left)] text-slate-900 antialiased"
  >
    <Analytics />
    <header class="bg-blue-700 pt-[env(safe-area-inset-top)] text-white shadow">
      <div class="flex items-center gap-6 px-4 py-3">
        <a href={localizePath(lang)} class="flex items-center gap-2 text-lg font-semibold">
          <img src="/logo-56.webp" alt="" width="28" height="28" class="size-7" />
          {t('site.name')}
        </a>
        <!-- Larger screens only; phones and small tablets have the bottom tab bar (BottomNav.astro).
             Short labels up to 1024px, so the row fits at 768px in Greek. -->
        <!-- No Home link: the logo already goes there. -->
        <nav aria-label={t('nav.main')} class="hidden items-center gap-1 md:flex">
          <a
            href={localizePath(lang, 'schedules')}
            class="nav-link"
            aria-current={path === 'schedules' ? 'page' : undefined}
          >
            <span class="lg:hidden">{t('nav.schedulesShort')}</span>
            <span class="hidden lg:inline">{t('nav.schedules')}</span>
          </a>
          <a
            href={localizePath(lang, 'destinations')}
            class="nav-link"
            aria-current={path.startsWith('destinations') ? 'page' : undefined}
          >
            <span class="lg:hidden">{t('nav.destinationsShort')}</span>
            <span class="hidden lg:inline">{t('nav.destinations')}</span>
          </a>
        </nav>
        <div class="ml-auto shrink-0">
          <LanguagePicker lang={lang} path={path} />
        </div>
      </div>
    </header>
    <ServiceNotice lang={lang} />
    <main class="min-h-0 flex-1">
      <slot />
    </main>
    <BottomNav lang={lang} path={path} />
    <!-- Larger screens only; on phones these links are in the tab bar's "More" sheet. -->
    <footer
      class="hidden border-t border-slate-200 bg-white px-4 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] text-xs text-slate-500 md:block"
    >
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
        <p>{t('footer.disclaimer')}</p>
        <nav class="flex gap-4">
          <SupportDialog lang={lang} />
          <a href={localizePath(lang, 'faq')} class="hover:text-slate-900 hover:underline">
            {t('footer.faq')}
          </a>
          <a href={localizePath(lang, 'privacy')} class="hover:text-slate-900 hover:underline">
            {t('footer.privacy')}
          </a>
        </nav>
      </div>
    </footer>
    <script>
      // Service worker (public/sw.js): faster repeat visits and an offline page. Production only:
      // in development it would serve stale files.
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
