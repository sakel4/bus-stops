---
// Layout for text pages written in Markdown (src/pages/[en/]{faq,privacy}.md).
import Layout from './Layout.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    /** Path without locale prefix, e.g. 'privacy'; used for the language switcher. */
    path: string;
    /** Optional line under the title, e.g. the last-updated date. */
    updated?: string;
  };
}

const { title, description, path, updated } = Astro.props.frontmatter;
---

<Layout title={title} description={description} path={path}>
  <div class="h-full overflow-y-auto">
    <article
      class="mx-auto max-w-3xl px-4 py-8 text-slate-700 [&_a]:font-medium [&_a]:text-blue-700 [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:text-blue-900 [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-slate-900 [&_h3]:mt-6 [&_h3]:font-semibold [&_h3]:text-slate-900 [&_li]:leading-relaxed [&_strong]:font-semibold [&_strong]:text-slate-900 [&_p]:mt-3 [&_p]:leading-relaxed [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-6"
    >
      <h1 class="text-3xl font-semibold text-slate-900">{title}</h1>
      {updated && <p class="text-sm text-slate-500">{updated}</p>}
      <slot />
    </article>
  </div>
</Layout>
